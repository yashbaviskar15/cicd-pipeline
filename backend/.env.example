# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
SERVICE_VERSION=1.0.0
LOG_LEVEL=info
# Set to "true" for human-readable logs in local development
LOG_PRETTY=false

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cicd?schema=public

# ---------------------------------------------------------------------------
# Authentication
# Generate a strong secret: openssl rand -hex 32
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-in-production-min-16-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ---------------------------------------------------------------------------
# HTTP / Security
# Comma separated list of allowed origins, or "*" for all
# ---------------------------------------------------------------------------
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=cicd-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
