{
  "env": {
    "node": true,
    "es2021": true,
    "jest": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "ignorePatterns": ["node_modules/", "coverage/", "src/generated/"],
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_|next$" }]
  }
}
