# Root-level environment for docker-compose (local development).
# Copy to .env and adjust. NEVER commit a real .env file.

# --- Postgres (compose service) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password
POSTGRES_DB=app

# --- Backend ---
NODE_ENV=development
SERVICE_VERSION=1.0.0
LOG_LEVEL=info
# Used by the backend container; host/port match the compose service name.
DATABASE_URL=postgresql://app:app_password@postgres:5432/app?schema=public
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=local-development-secret-change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=*

# --- OpenTelemetry (optional) ---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces

# --- Frontend (Vercel / build-time) ---
# Leave empty to use the same origin (nginx proxy) in local compose.
VITE_API_BASE_URL=
