{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Availability (5m)",
      "description": "SLO target: 99.5%",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "100 * sli:http_availability:ratio_rate5m", "legendFormat": "availability" }
      ],
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 3,
          "min": 95,
          "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 99.5 },
            { "color": "green", "value": 99.9 }
          ] }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "p95 latency (5m)",
      "description": "SLO target: < 300 ms",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sli:http_latency_p95:rate5m", "legendFormat": "p95" }
      ],
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.3 },
            { "color": "red", "value": 0.5 }
          ] }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error budget burn (5m / fast)",
      "description": "1.0x = sustainable. >14.4x pages (fast burn).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sli:http_error_ratio:rate5m / 0.005", "legendFormat": "burn rate" }
      ],
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "x",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 6 },
            { "color": "red", "value": 14.4 }
          ] }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error budget burn (30m / slow)",
      "description": ">6x opens a ticket (slow burn).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sli:http_error_ratio:rate30m / 0.005", "legendFormat": "burn rate" }
      ],
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "x",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 6 },
            { "color": "red", "value": 14.4 }
          ] }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Availability vs 99.5% SLO",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        { "refId": "A", "expr": "100 * sli:http_availability:ratio_rate5m", "legendFormat": "availability" },
        { "refId": "B", "expr": "99.5", "legendFormat": "SLO" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 95, "max": 100, "custom": { "fillOpacity": 0, "lineWidth": 2 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "SLO" }, "properties": [
            { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
            { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
          ] }
        ]
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Latency p95 vs 300 ms SLO",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        { "refId": "A", "expr": "sli:http_latency_p95:rate5m", "legendFormat": "p95" },
        { "refId": "B", "expr": "0.3", "legendFormat": "SLO 300ms" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 0, "lineWidth": 2 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "SLO 300ms" }, "properties": [
            { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
            { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
          ] }
        ]
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Error budget burn rate (multiwindow)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [
        { "refId": "A", "expr": "sli:http_error_ratio:rate5m / 0.005", "legendFormat": "fast (5m)" },
        { "refId": "B", "expr": "sli:http_error_ratio:rate30m / 0.005", "legendFormat": "slow (30m)" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "x", "custom": { "fillOpacity": 0, "lineWidth": 2 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "fast (5m)" }, "properties": [
            { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [5, 5] } }
          ] }
        ]
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "5xx errors / sec",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "targets": [
        { "refId": "A", "expr": "sum by (route) (rate(http_errors_total[5m]))", "legendFormat": "{{route}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 20, "lineWidth": 1 } }, "overrides": [] }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["cicd-pipeline", "slo", "sre"],
  "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "SLO · Availability & Latency",
  "uid": "slo-overview",
  "version": 1,
  "weekStart": ""
}
