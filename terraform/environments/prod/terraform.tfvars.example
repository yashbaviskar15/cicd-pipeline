# Copy to terraform.tfvars and adjust. This is the PRODUCTION environment.
# Every difference from dev/staging is a deliberate production choice.

aws_region  = "us-east-1"
project     = "cicd-pipeline"
environment = "prod"

# --- GitHub (for the OIDC deploy role) ---
github_owner = "yashbaviskar15"
github_repo  = "cicd-pipeline"
# The GitHub OIDC provider is created once per account (in dev), so reuse it.
create_oidc_provider = false
allowed_branches     = ["main"]

# --- Networking (a NAT gateway per AZ for resilience) ---
vpc_cidr           = "10.2.0.0/16"
enable_nat_gateway = true
single_nat_gateway = false

# --- Application image (replaced by CI after the first push) ---
backend_image   = "public.ecr.aws/nginx/nginx:alpine"
task_cpu        = "512"
task_memory     = "1024"
desired_count   = 2
service_version = "prod"
cors_origin     = "https://app.example.com"

# --- Deployment strategy: CodeDeploy blue/green with auto-rollback ---
deployment_controller = "CODE_DEPLOY"
enable_autoscaling    = true
min_capacity          = 2
max_capacity          = 6
cpu_target_utilization = 60
requests_per_target    = 1000

# --- Database (Multi-AZ + deletion protection; NOT free tier) ---
db_instance_class      = "db.t4g.micro"
db_allocated_storage   = 20
db_multi_az            = true
db_deletion_protection = true
db_skip_final_snapshot = false

# --- TLS / DNS (recommended in prod) ---
enable_https = true
# certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/xxxx"
# domain_name     = "app.example.com"
# hosted_zone_id  = "Z0123456789ABCDEFGHIJ"

# --- Alerts ---
# alarm_email = "oncall@example.com"
