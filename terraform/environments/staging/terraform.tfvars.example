# Copy to terraform.tfvars and adjust. This is the STAGING environment.

aws_region  = "us-east-1"
project     = "cicd-pipeline"
environment = "staging"

# --- GitHub (for the OIDC deploy role) ---
github_owner = "yashbaviskar15"
github_repo  = "cicd-pipeline"
# The GitHub OIDC provider is created once per account (in dev), so reuse it.
create_oidc_provider = false
allowed_branches     = ["main"]

# --- Networking ---
vpc_cidr           = "10.1.0.0/16"
enable_nat_gateway = true
single_nat_gateway = true

# --- Application image (replaced by CI after the first push) ---
backend_image   = "public.ecr.aws/nginx/nginx:alpine"
task_cpu        = "256"
task_memory     = "512"
desired_count   = 1
service_version = "staging"
cors_origin     = "*"

# --- Deployment strategy ---
deployment_controller = "CODE_DEPLOY"
enable_autoscaling    = true
min_capacity          = 1
max_capacity          = 3

# --- Database (free-tier eligible) ---
db_instance_class    = "db.t4g.micro"
db_allocated_storage = 20
db_multi_az          = false

# --- TLS / DNS (optional) ---
enable_https = false
# certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/xxxx"
# domain_name     = "staging.example.com"
# hosted_zone_id  = "Z0123456789ABCDEFGHIJ"

# --- Alerts (optional) ---
# alarm_email = "you@example.com"
